# Configuración de tu biblioteca · Your library's configuration
#
# Copia este archivo como .env (cp .env.example .env) y llena los valores.
# Copy this file to .env (cp .env.example .env) and fill in the values.
# Guía completa / full guide: docs/es/guia.md · docs/en/guide.md
#
# Nada de esto es secreto: termina dentro del JavaScript público del sitio.
# None of this is secret: it ends up inside the site's public JavaScript.

# ID de cliente OAuth de Google Cloud (termina en .apps.googleusercontent.com).
# Vacío = modo demostración con el catálogo de ejemplo, sin Google.
# Google Cloud OAuth client ID. Empty = demo mode with the sample catalog.
VITE_GOOGLE_CLIENT_ID=

# Nombre de tu biblioteca y una parte destacada opcional (se ve en otro color).
# Your library's name and an optional highlighted part (shown in another color).
VITE_LIBRARY_NAME=Biblioteca
VITE_LIBRARY_ACCENT=

# Nombre de la carpeta raíz en Drive, para el mensaje a quien aún no tiene acceso.
# Name of the root Drive folder, for the message shown to people without access.
VITE_DRIVE_FOLDER_NAME=

# Nombre del archivo del catálogo en Drive. Igual que NOMBRE_CATALOGO en apps-script/config.gs.
# Catalog file name in Drive. Same as NOMBRE_CATALOGO in apps-script/config.gs.
VITE_CATALOG_FILE=biblioteca-catalogo.json

# Idioma inicial: es o en (cada quien puede cambiarlo en la app).
# Initial language: es or en (each reader can switch it in the app).
VITE_DEFAULT_LANG=es

# Sal para las huellas de los invitados. Pon un texto al azar y no lo cambies después.
# Salt for invitation fingerprints. Use a random text and do not change it later.
VITE_INVITE_SALT=cambia-esto-por-un-texto-al-azar

# Huellas de los correos invitados. No lo edites a mano: usa npm run permitir.
# Invited email fingerprints. Do not edit by hand: use npm run permitir.
VITE_ALLOWED=
